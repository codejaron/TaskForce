# ========================================
# TaskForce - 本地开发环境变量示例
# ========================================

# Spring 通用
SPRING_PROFILES_ACTIVE=local

# Backend 数据库
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ai_platform?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Nacos（如未使用可留空）
NACOS_ADDR=localhost:8848
NACOS_NAMESPACE=

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# ========================================
# 说明：
# 1. 可复制此文件为 .env 并按本地环境调整
# 2. 敏感信息请妥善保管，不要提交到版本控制
# ========================================
