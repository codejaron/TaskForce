# ========================================
# TaskForce - Docker 环境配置
# ========================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=TaskForce123456
MYSQL_PORT=3306

# Redis 配置
REDIS_PORT=6379

# RocketMQ 配置
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_DASHBOARD_PORT=18080

# 后端服务配置
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
JAVA_OPTS=-Xms512m -Xmx1024m

# 前端服务配置
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# ========================================
# 说明：
# 1. 复制此文件为 .env 并根据需要修改配置
# 2. 敏感信息请妥善保管，不要提交到版本控制
# ========================================

