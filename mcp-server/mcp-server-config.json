{
  "providers": {
    "weather": {
      "type": "STDIO",
      "enabled": true,
      "description": "Weather information tools",
      "command": "npx",
      "args": ["-y", "@anthropics/weather-server"],
      "env": {}
    },
    "filesystem": {
      "type": "STDIO",
      "enabled": false,
      "description": "File system operations",
      "command": "npx",
      "args": ["-y", "@anthropics/filesystem-server", "/tmp"],
      "env": {}
    },
    "artifact_tools": {
      "type": "NATIVE",
      "enabled": false,
      "description": "Artifact query and management tools",
      "beanName": "artifactTools",
      "className": "com.agent.service.tool.ArtifactTools"
    },
    "n8n_gmail": {
      "type": "REMOTE_SSE",
      "enabled": false,
      "description": "Gmail integration via n8n",
      "sseUrl": "https://your-n8n-instance.com/mcp/gmail/sse",
      "headers": {
        "Authorization": "Bearer ${N8N_API_KEY}"
      },
      "timeout": 60
    }
  }
}
